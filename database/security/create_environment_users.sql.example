-- Replace every <SET-...> value before review. Run as an authorized MySQL administrator.
CREATE USER IF NOT EXISTS 'd365_finance_uat_app'@'<SET-APP-HOST>' IDENTIFIED BY '<SET-UAT-APP-PASSWORD>';
CREATE USER IF NOT EXISTS 'd365_finance_prod_app'@'<SET-APP-HOST>' IDENTIFIED BY '<SET-PROD-APP-PASSWORD>';
CREATE USER IF NOT EXISTS 'd365_finance_uat_migrator'@'<SET-ADMIN-HOST>' IDENTIFIED BY '<SET-UAT-MIGRATOR-PASSWORD>';
CREATE USER IF NOT EXISTS 'd365_finance_prod_migrator'@'<SET-ADMIN-HOST>' IDENTIFIED BY '<SET-PROD-MIGRATOR-PASSWORD>';

GRANT SELECT, INSERT, UPDATE, DELETE, EXECUTE ON D365_finance.* TO 'd365_finance_uat_app'@'<SET-APP-HOST>';
GRANT SELECT, INSERT, UPDATE, DELETE, EXECUTE ON D365_finance_prod.* TO 'd365_finance_prod_app'@'<SET-APP-HOST>';

GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES,
    CREATE VIEW, SHOW VIEW, TRIGGER, EXECUTE
    ON D365_finance.* TO 'd365_finance_uat_migrator'@'<SET-ADMIN-HOST>';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES,
    CREATE VIEW, SHOW VIEW, TRIGGER, EXECUTE
    ON D365_finance_prod.* TO 'd365_finance_prod_migrator'@'<SET-ADMIN-HOST>';
